        <item>
         <layout class="QHBoxLayout" name="layoutOutput">
          <item>
           <widget class="QCheckBox" name="checkOutput">
            <property name="toolTip">
             <string>Take each stem from the output track instead of from the track itself, so it gets the effects and the fader of the output track (and of the group tracks on the way). Only that track is heard while its stem is rendered.</string>
            </property>
            <property name="text">
             <string>Through the output track's effects</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QComboBox" name="comboOutput">
