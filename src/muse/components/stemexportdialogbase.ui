             <sizepolicy hsizetype="Expanding" vsizetype="Fixed"/>
            </property>
           </widget>
          </item>
         </layout>
        </item>
        <item>
         <widget class="QLabel" name="labelTrackInfo">
          <property name="text">
           <string>Each stem is the track's output after its fader and pan, plus what its aux sends return (reverb, delay ...). Group tracks and the master output are not included. A midi track is rendered through the synth it plays.</string>
          </property>
          <property name="wordWrap">
           <bool>true</bool>
          </property>
         </widget>
        </item>
